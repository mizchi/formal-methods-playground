# Alloy
*.als.bak
# alloy6 exec writes solution markdown + receipt.json into a dir
# named after the .als stem; not worth tracking
**/receipt.json
**/*-solution-*.md

# TLA+ (Toolbox + TLC)
*.toolbox/
MC_*.tla
MC_*.cfg
states/
*.tla.bak
# TLC writes a trace-exploration spec next to the module on every violation;
# the breaking variants in usecases/ are meant to be run by hand, so ignore it
*_TTrace_*.tla
*_TTrace_*.bin

# Quint (generated TLA+ / Apalache output)
_apalache-out/

# FizzBee (compiled spec + state-space explorer output)
languages/fizzbee/*.json
languages/fizzbee/out/

# Dafny
*.dll
*.pdb
*-go/
*-py/
*-js/
*-cs/
obj/
bin/

